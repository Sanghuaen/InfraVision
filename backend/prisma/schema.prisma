

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// สร้าง Table ชื่อ User"
model User {
  id        Int      @id @default(autoincrement())    //id= Integer= Primary Key
  email     String   @unique                          // @unique =ห้ามซ้ำ
  name      String?                                   // ? = Optional / Nullable
  password String          
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}